# systemd unit for running wx-bot inside the Muse runtime (guest system manager).
# Replace <home> with the absolute home directory and root with the user
# that owns it, then install to /etc/systemd/system/wx-bot.service.
[Unit]
Description=wx-bot WeChat iLink bridge (pull delivery for Muse)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Environment=HOME=<home>
WorkingDirectory=<home>
EnvironmentFile=-<home>/.config/wx-bot/env
ExecStart=<home>/.local/bin/wx-bot --config <home>/.config/wx-bot/config.json run
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
MemoryMax=256M

[Install]
WantedBy=default.target
